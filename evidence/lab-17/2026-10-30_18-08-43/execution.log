$ docker compose config
name: university-network
services:
  gateway:
    build:
      context: /workspace/huawei-lab
      dockerfile: gateway/Dockerfile
    cap_add:
      - NET_ADMIN
    healthcheck:
      test:
        - CMD-SHELL
        - test $$(cat /proc/sys/net/ipv4/ip_forward) = 1 && nft list chain inet lab_filter forward >/dev/null && nft list chain ip lab_nat postrouting >/dev/null
      timeout: 2s
      interval: 2s
      retries: 10
    networks:
      corporate:
        ipv4_address: 172.28.20.254
      guest:
        ipv4_address: 172.28.10.254
      iot:
        ipv4_address: 172.28.30.254
      management:
        ipv4_address: 172.28.50.254
      uplink:
        gw_priority: 1
        ipv4_address: 172.28.40.254
    secrets:
      - source: gateway_token
        target: /run/secrets/gateway_token
    sysctls:
      net.ipv4.ip_forward: "1"
    volumes:
      - type: bind
        source: /workspace/huawei-lab/gateway/nftables.conf
        target: /etc/nftables.conf
        read_only: true
        bind: {}
      - type: bind
        source: /workspace/huawei-lab/gateway/nat.conf
        target: /etc/nat.conf
        read_only: true
        bind: {}
  guest-client:
    build:
      context: /workspace/huawei-lab/client
      dockerfile: Dockerfile
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.10.254
        exec sleep infinity
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    networks:
      guest:
        ipv4_address: 172.28.10.10
  guest-peer:
    build:
      context: /workspace/huawei-lab/client
      dockerfile: Dockerfile
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - ip route replace default via 172.28.10.254; exec sleep infinity
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    networks:
      guest:
        ipv4_address: 172.28.10.11
  internal-site:
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.20.254
        exec nginx -g 'daemon off;'
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    image: nginx:stable-alpine
    networks:
      corporate:
        ipv4_address: 172.28.20.10
    volumes:
      - type: bind
        source: /workspace/huawei-lab/internal-site/nginx.conf
        target: /etc/nginx/nginx.conf
        read_only: true
        bind: {}
  iot-client:
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.30.254
        exec sleep infinity
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    image: alpine:3.22
    networks:
      iot:
        ipv4_address: 172.28.30.10
  portal:
    build:
      context: /workspace/huawei-lab
      dockerfile: auth/Dockerfile
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    environment:
      COOKIE_SECURE: "false"
      SESSION_TTL_SECONDS: "300"
    healthcheck:
      test:
        - CMD
        - wget
        - -qO-
        - http://127.0.0.1:8080/healthz
      timeout: 2s
      interval: 2s
      retries: 15
    networks:
      guest:
        ipv4_address: 172.28.10.20
      management:
        ipv4_address: 172.28.50.10
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 8080
        published: "8080"
        protocol: tcp
    secrets:
      - source: gateway_token
        target: /run/secrets/gateway_token
      - source: test_users
        target: /run/secrets/test_users
    volumes:
      - type: volume
        source: portal-data
        target: /data
        volume: {}
networks:
  corporate:
    name: university-network_corporate
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.20.0/24
          gateway: 172.28.20.1
  guest:
    name: university-network_guest
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.10.0/24
          gateway: 172.28.10.1
  iot:
    name: university-network_iot
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.30.0/24
          gateway: 172.28.30.1
  management:
    name: university-network_management
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.50.0/24
          gateway: 172.28.50.1
    internal: true
  uplink:
    name: university-network_uplink
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.40.0/24
          gateway: 172.28.40.1
volumes:
  portal-data:
    name: university-network_portal-data
secrets:
  gateway_token:
    name: university-network_gateway_token
    file: /workspace/huawei-lab/.secrets/gateway-token
  test_users:
    name: university-network_test_users
    file: /workspace/huawei-lab/.secrets/test-users.json
