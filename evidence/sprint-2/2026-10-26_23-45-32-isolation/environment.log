$ docker compose config
name: university-network
services:
  gateway:
    build:
      context: /workspace/huawei-lab/gateway
      dockerfile: Dockerfile
    cap_add:
      - NET_ADMIN
    healthcheck:
      test:
        - CMD-SHELL
        - test $$(cat /proc/sys/net/ipv4/ip_forward) = 1 && nft list chain inet lab_filter forward >/dev/null
      timeout: 2s
      interval: 2s
      retries: 10
    networks:
      corporate:
        ipv4_address: 172.28.20.254
      guest:
        ipv4_address: 172.28.10.254
      iot:
        ipv4_address: 172.28.30.254
    sysctls:
      net.ipv4.ip_forward: "1"
    volumes:
      - type: bind
        source: /workspace/huawei-lab/gateway/nftables.conf
        target: /etc/nftables.conf
        read_only: true
        bind: {}
  guest-client:
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.10.254
        exec sleep infinity
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    image: alpine:3.22
    networks:
      guest:
        ipv4_address: 172.28.10.10
  internal-site:
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.20.254
        exec nginx -g 'daemon off;'
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    image: nginx:stable-alpine
    networks:
      corporate:
        ipv4_address: 172.28.20.10
  iot-client:
    cap_add:
      - NET_ADMIN
    command:
      - sh
      - -c
      - |
        ip route replace default via 172.28.30.254
        exec sleep infinity
    depends_on:
      gateway:
        condition: service_healthy
        required: true
    image: alpine:3.22
    networks:
      iot:
        ipv4_address: 172.28.30.10
networks:
  corporate:
    name: university-network_corporate
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.20.0/24
          gateway: 172.28.20.1
  guest:
    name: university-network_guest
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.10.0/24
          gateway: 172.28.10.1
  iot:
    name: university-network_iot
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.30.0/24
          gateway: 172.28.30.1

